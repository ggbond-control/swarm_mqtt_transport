<?xml version="1.0"?>
<package format="3">
  <name>swarm_mqtt_transport</name>
  <version>0.1.0</version>
  <description>Bounded MQTT relay for device consensus and platform ingress.</description>
  <maintainer email="robot@example.com">Robot Inspection Team</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>swarm_protocol</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>python3-paho-mqtt</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
